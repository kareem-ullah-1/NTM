NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/ntm_fabrics
PGSSL=false
# Vercel: use a pooled connection string and a small pool, e.g. PGPOOL_MAX=3
# PGPOOL_MAX=20
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

FRONTEND_URL=http://localhost:3000
# Optional: extra allowed CORS origins, comma-separated, no trailing slash.
# CORS_ORIGIN=https://ntm-3bq9.vercel.app

# Optional. Leave unset to use in-memory rate limiting (no Redis needed).
# When set, it must be a managed Redis URL; use rediss:// for TLS (e.g. Upstash).
# A localhost URL is ignored when NODE_ENV=production.
# REDIS_URL=rediss://default:password@your-redis-host:6379

ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_REGISTRATION_CODE=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_UPLOAD_FOLDER=ntm-fabrics/products

# --- Order confirmation email (required for customer emails) ---
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional: defaults to SMTP_USER (required for Gmail compatibility)
NOTIFICATION_FROM_EMAIL=your-gmail@gmail.com
NOTIFICATION_FROM_NAME=NTM Fabrics
# Set true only when using port 465
# SMTP_SECURE=false

# Optional: SMS via Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
