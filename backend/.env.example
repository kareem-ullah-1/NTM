NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@localhost:5432/ntm_fabrics
PGSSL=false

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
# Optional: extra allowed CORS origins, comma-separated, no trailing slash.
# CORS_ORIGIN=https://ntm-3bq9.vercel.app

# Optional — when set, rate limiting uses Redis (shared across instances).
# Leave unset for simple local development (in-memory rate limits).
# REDIS_URL=redis://localhost:6379

# --- Order confirmation email (required for customer emails) ---
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional: defaults to SMTP_USER (required for Gmail compatibility)
NOTIFICATION_FROM_EMAIL=your-gmail@gmail.com
NOTIFICATION_FROM_NAME=NTM Fabrics
# Set true only when using port 465
# SMTP_SECURE=false
